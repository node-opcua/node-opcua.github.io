---
import '../styles/global.css';
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { url } from '../utils/url';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  articleMeta?: {
    publishedTime: string;
    author: string;
  };
}

const { 
  title, 
  description = "node-opcua: The open-source OPC UA stack for Node.js. Production-grade since 2014.",
  ogImage = url("og-default.png"),
  canonical,
  articleMeta,
} = Astro.props;

const site = 'https://node-opcua.github.io';

// Organization JSON-LD (emitted on every page)
const orgLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "node-opcua",
  "url": site,
  "logo": `${site}/logos/sterfive-logo.png`,
  "description": "The open-source OPC UA stack for Node.js, maintained by Sterfive.",
  "sameAs": [
    "https://github.com/node-opcua",
    "https://www.npmjs.com/package/node-opcua",
    "https://www.sterfive.com"
  ]
};

// Canonical: use explicit prop if provided, otherwise derive from pathname.
// For format:'file' pages, pathname already ends in .html.
const canonicalPath = canonical || Astro.url.pathname;
const canonicalUrl = new URL(canonicalPath, "https://node-opcua.github.io").href;
const fullTitle = `${title} | node-opcua`;
const ogImageUrl = new URL(ogImage, "https://node-opcua.github.io").href;

// Noindex is env-conditional: only present when PUBLIC_STAGING=true.
// Default (flag absent) = indexable. Safe for production cutover.
const isStaging = import.meta.env.PUBLIC_STAGING === "true";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href={url("favicon.ico")} />
    
    {isStaging && (
      <meta name="robots" content="noindex,nofollow" />
    )}
    
    <title>{fullTitle}</title>
    <link rel="canonical" href={canonicalUrl} />
    <meta name="description" content={description} />
    
    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={canonicalUrl} />
    {articleMeta ? (
      <meta property="og:type" content="article" />
      <meta property="article:published_time" content={articleMeta.publishedTime} />
      <meta property="article:author" content={articleMeta.author} />
    ) : (
      <meta property="og:type" content="website" />
    )}
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Organization JSON-LD (site-wide) -->
    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />

    <!-- Slot for child layout head content (JSON-LD etc.) -->
    <slot name="head" />
    <Analytics />
  </head>
  <body>
    <NavBar />
    <main>
      <slot />
    </main>
    <Footer />
    <ConsentBanner />
  </body>
</html>
