---
import '../styles/global.css';
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { url } from '../utils/url';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { 
  title, 
  description = "node-opcua: The open-source OPC UA stack for Node.js. Production-grade since 2014.",
  ogImage = url("og-default.png")
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, "https://node-opcua.github.io").href;
const fullTitle = `${title} | node-opcua`;
const ogImageUrl = new URL(ogImage, "https://node-opcua.github.io").href;

// Noindex is env-conditional: only present when PUBLIC_STAGING=true.
// Default (flag absent) = indexable. Safe for production cutover.
const isStaging = import.meta.env.PUBLIC_STAGING === "true";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href={url("favicon.ico")} />
    
    {isStaging && (
      <meta name="robots" content="noindex,nofollow" />
    )}
    
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    
    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <Analytics />
  </head>
  <body>
    <NavBar />
    <main>
      <slot />
    </main>
    <Footer />
    <ConsentBanner />
  </body>
</html>
