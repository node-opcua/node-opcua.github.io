---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', (p) => !p.data.draft);
allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const posts = allPosts.map((p) => ({
  title: p.data.title,
  date: p.data.date,
  url: `/${p.data.permalink}.html`,
  summary: p.data.description || '',
}));

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric'
  });
}
---

<BaseLayout title="News & writing">
  <div class="news-container">
    <section class="news-intro">
      <p class="section-eyebrow">News & writing</p>
      <h1>From the node-opcua project</h1>
      <p class="lede">
        Updates, technical writing, and release notes from the
        maintainers and community.
      </p>
    </section>

    <div class="news-list">
      {posts.map((post) => (
        <article class="post-card">
          <time class="post-date">{formatDate(post.date)}</time>
          <h2 class="post-title">
            <a href={post.url}>{post.title}</a>
          </h2>
          <p class="post-summary">{post.summary}</p>
          <a class="read-more" href={post.url}>
            Read post &rarr;
          </a>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .news-container {
    max-width: 720px;
    margin: 0 auto;
    padding: 4rem 2rem;
  }
  .news-intro {
    padding: 0 0 var(--space-stack-xl) 0;
    border-bottom: 1px solid var(--divider);
  }
  .news-intro h1 {
    font-size: clamp(2.5rem, 5.5vw, 3.75rem);
    font-weight: 700;
    color: var(--ink);
    margin-bottom: var(--space-stack-md);
    line-height: 1.15;
  }
  .lede {
    font-size: 1.2rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }
  .news-list {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
    padding: var(--space-stack-xl) 0;
  }
  .post-card {
    border-top: 2px solid var(--ink);
    padding-top: var(--space-stack-md);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .post-date {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .post-title {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.3;
  }
  .post-title a {
    color: var(--ink);
  }
  .post-title a:hover {
    color: var(--accent);
  }
  .post-summary {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }
  .read-more {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--accent);
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    align-self: flex-start;
  }
  .read-more:hover {
    color: var(--ink);
  }
</style>
