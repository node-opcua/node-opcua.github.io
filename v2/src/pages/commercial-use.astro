---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../utils/url';
---

<BaseLayout
  title="Commercial use of node-opcua"
  description="node-opcua is MIT-licensed. Commercial modules, support contracts, and consulting are available from Sterfive — the company that builds the stack."
>
  <section class="commercial-section">
    <div class="container commercial-container">
      <h1>Commercial use of node-opcua</h1>

      <div class="commercial-content">

        <div class="model-intro">
          <p class="intro-text">
            node-opcua uses an <strong>open-core model</strong>.
            The core SDK is MIT-licensed — you can use it in commercial products
            with no obligation to Sterfive. Commercial add-on modules and
            professional services are available for teams that need more.
          </p>
        </div>

        <div class="model-grid">
          <div class="model-card">
            <h2 class="model-title">Open core <span class="license-tag">MIT</span></h2>
            <p class="model-description">
              The full OPC UA client and server SDK, including subscriptions,
              alarms & conditions, historical access, security, and more.
              Free to use, modify, and distribute.
            </p>
            <ul class="model-list">
              <li>Client & server SDK</li>
              <li>Subscriptions & monitored items</li>
              <li>Alarms & conditions</li>
              <li>Historical access</li>
              <li>Security (PKI, certificates, encryption)</li>
              <li>XML nodeset import/export</li>
              <li>3,000+ tests, ~97% coverage</li>
            </ul>
            <a href="https://github.com/node-opcua/node-opcua" target="_blank" rel="noopener noreferrer" class="btn btn-secondary model-cta">
              Get the SDK <span class="arrow">&rarr;</span>
            </a>
          </div>

          <div class="model-card pro-card">
            <h2 class="model-title">Commercial add-ons <span class="license-tag pro-tag">PRO</span></h2>
            <p class="model-description">
              Extended modules for advanced use cases. Source code is available.
              Requires a NodeOPCUA Subscription from Sterfive.
            </p>
            <ul class="model-list">
              <li>Global Discovery Server (GDS)</li>
              <li>PubSub (UADP + JSON over MQTT)</li>
              <li>Optimized OPC UA client</li>
              <li>Address space crawler & exporter</li>
              <li>React UI components for OPC UA</li>
              <li>WebProxy — browser-to-OPC UA bridge</li>
            </ul>
            <a href="https://www.sterfive.com" target="_blank" rel="noopener noreferrer" class="btn btn-primary model-cta">
              View subscriptions <span class="arrow">&rarr;</span>
            </a>
          </div>
        </div>

        <div class="services-section">
          <h2>Professional services</h2>
          <p>
            Sterfive is the company that builds and maintains node-opcua.
            Beyond the subscription, the team offers:
          </p>
          <div class="services-grid">
            <div class="service-item">
              <h3>Support & SLAs</h3>
              <p>Guaranteed response times, priority bug fixes, and direct access to the node-opcua authors.</p>
            </div>
            <div class="service-item">
              <h3>Custom development</h3>
              <p>Bespoke OPC UA servers, gateways, companion spec implementations, and product integrations.</p>
            </div>
            <div class="service-item">
              <h3>Consulting</h3>
              <p>Architecture reviews, OPC UA specification guidance, security audits, and performance optimization.</p>
            </div>
            <div class="service-item">
              <h3>Training</h3>
              <p>Hands-on OPC UA training courses, from fundamentals to advanced security and modeling.</p>
            </div>
          </div>
        </div>

        <hr class="separator" />

        <div class="commercial-ctas">
          <a href="https://www.sterfive.com" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
            Go to sterfive.com <span class="arrow">&rarr;</span>
          </a>
          <a href="https://support.sterfive.com" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            Go to support.sterfive.com <span class="arrow">&rarr;</span>
          </a>
        </div>

        <hr class="separator" />

        <div class="sustain-section">
          <p class="sustain-text">
            Not ready for a commercial engagement? You can still sustain the open project
            through GitHub Sponsors.
          </p>
          <a href="https://github.com/sponsors/node-opcua" target="_blank" rel="noopener noreferrer" class="btn btn-tertiary sustain-btn">
            Sponsor node-opcua <span class="arrow">&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .commercial-section {
    padding: var(--space-section) 0;
    min-height: 70vh;
  }
  .commercial-container {
    max-width: 800px;
    margin: 0 auto;
  }
  h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    margin-bottom: 2.5rem;
    letter-spacing: -0.025em;
    line-height: 1.2;
    color: var(--ink);
  }
  .commercial-content {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }
  .intro-text {
    font-size: 1.1rem;
    color: var(--ink);
    line-height: 1.65;
  }

  /* Model grid */
  .model-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  .model-card {
    border: 1px solid var(--divider);
    border-radius: 6px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .pro-card {
    border-color: var(--accent);
    border-width: 2px;
  }
  .model-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--ink);
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .license-tag {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 2px 6px;
    border-radius: 3px;
    border: 1.5px solid var(--muted);
    color: var(--muted);
  }
  .pro-tag {
    border-color: var(--accent);
    color: var(--accent);
  }
  .model-description {
    font-size: 0.95rem;
    color: var(--ink-soft);
    line-height: 1.6;
  }
  .model-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .model-list li {
    font-size: 0.9rem;
    color: var(--ink);
    padding-left: 1.25rem;
    position: relative;
  }
  .model-list li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 700;
    font-size: 0.85rem;
  }
  .model-cta {
    margin-top: auto;
    align-self: flex-start;
  }

  /* Services */
  .services-section h2 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 0.75rem;
  }
  .services-section > p {
    font-size: 1rem;
    color: var(--ink-soft);
    margin-bottom: 1.5rem;
  }
  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  .service-item {
    border-top: 1px solid var(--divider);
    padding-top: 1rem;
  }
  .service-item h3 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 0.35rem;
  }
  .service-item p {
    font-size: 0.9rem;
    color: var(--ink-soft);
    line-height: 1.5;
  }

  .separator {
    border: 0;
    height: 1px;
    background-color: var(--divider);
    margin: 0.5rem 0;
  }
  .commercial-ctas {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
  }
  .sustain-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }
  .sustain-text {
    font-size: 0.95rem;
    color: var(--ink-soft);
  }
  .sustain-btn {
    background-color: transparent;
    border: 1px dashed var(--divider);
    color: var(--ink);
    border-radius: 6px;
  }
  .sustain-btn:hover {
    border-style: solid;
    border-color: var(--muted);
    background-color: var(--accent-soft);
  }
  .arrow {
    margin-left: 0.5rem;
    transition: transform 0.2s ease;
  }
  .btn:hover .arrow {
    transform: translateX(3px);
  }

  @media (min-width: 768px) {
    .model-grid {
      grid-template-columns: 1fr 1fr;
    }
    .services-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 640px) {
    .commercial-ctas {
      flex-direction: column;
      width: 100%;
    }
    .btn {
      width: 100%;
    }
  }
</style>
