---
// src/components/ConsentBanner.astro
// GDPR/CNIL-compliant consent banner. Renders only when analytics is enabled
// and no prior consent choice exists (checked client-side).
import { url } from '../utils/url';

const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const isStaging = import.meta.env.PUBLIC_STAGING === "true";
const enableAnalytics = gaId && !isStaging;
---

{enableAnalytics && (
  <div id="consent-banner" class="consent-banner">
    <div class="consent-inner">
      <div class="consent-text">
        <span class="consent-eyebrow">Analytics</span>
        <p class="consent-body">
          We use Google Analytics to measure traffic: page views, country,
          and referrer. No advertising, no cross-site tracking, no profiling.
          <a href={url("privacy.html")} class="consent-privacy-link">Privacy details</a>
        </p>
      </div>
      <div class="consent-actions">
        <button id="consent-accept" class="consent-btn consent-btn-accept" type="button">Accept</button>
        <button id="consent-reject" class="consent-btn consent-btn-reject" type="button">Reject</button>
      </div>
    </div>
  </div>

  <script is:inline>
    (function() {
      // Check if consent was already given — hide banner immediately
      var hasCookie = document.cookie.split('; ').some(function(row) {
        return row.startsWith('na_consent=');
      });
      if (hasCookie) {
        document.getElementById('consent-banner').style.display = 'none';
        return;
      }

      function setConsent(choice) {
        var sixMonths = 60 * 60 * 24 * 180;
        document.cookie = 'na_consent=' + choice + '; max-age=' + sixMonths + '; path=/; SameSite=Lax';

        if (choice === 'granted' && window.gtag) {
          window.gtag('consent', 'update', { 'analytics_storage': 'granted' });
        }
        document.getElementById('consent-banner').style.display = 'none';
      }

      document.getElementById('consent-accept')
        .addEventListener('click', function() { setConsent('granted'); });
      document.getElementById('consent-reject')
        .addEventListener('click', function() { setConsent('denied'); });
    })();
  </script>
)}

<style>
  .consent-banner {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 9999;
    background: var(--bg-elevated, #f5f4f0);
    border-top: 1px solid var(--divider, #d4d2cc);
    opacity: 0;
    animation: consent-fade-in 200ms ease forwards;
  }
  @keyframes consent-fade-in {
    to { opacity: 1; }
  }

  .consent-inner {
    max-width: 64rem;
    margin: 0 auto;
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .consent-text {
    flex: 1;
  }

  .consent-eyebrow {
    display: block;
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted, #8a8880);
    margin-bottom: 0.375rem;
  }

  .consent-body {
    font-family: var(--font-sans, sans-serif);
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--ink-soft, #5c5c56);
    margin: 0;
  }

  .consent-privacy-link {
    color: var(--muted, #8a8880);
    font-size: 0.8125rem;
    text-decoration: none;
    margin-left: 0.25rem;
  }
  .consent-privacy-link:hover {
    text-decoration: underline;
  }

  .consent-actions {
    display: flex;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .consent-btn {
    font-family: var(--font-sans, sans-serif);
    font-size: 0.875rem;
    font-weight: 500;
    padding: 0.5rem 1.25rem;
    border-radius: 6px;
    cursor: pointer;
    transition: opacity 0.15s ease;
  }
  .consent-btn:hover {
    opacity: 0.85;
  }

  .consent-btn-accept {
    background: var(--accent, #2a7a6e);
    color: #fff;
    border: 1px solid var(--accent, #2a7a6e);
  }

  .consent-btn-reject {
    background: transparent;
    color: var(--ink, #2c2c28);
    border: 1px solid var(--ink, #2c2c28);
  }

  /* Mobile: stack text above buttons */
  @media (max-width: 767px) {
    .consent-inner {
      flex-direction: column;
      align-items: stretch;
      gap: 1rem;
      padding: 1rem 1.25rem;
    }
    .consent-actions {
      justify-content: stretch;
    }
    .consent-btn {
      flex: 1;
    }
  }
</style>
