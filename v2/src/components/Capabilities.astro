---
import { url } from '../utils/url';
const features = [
  {
    category: "Complete OPC UA surface",
    intro: "Every part of the spec you actually deploy, in one package.",
    items: [
      { text: "Client and Server (Part 4, Part 5)" },
      { text: "Subscriptions, monitored items, method calls" },
      { text: "Alarms and Conditions (Part 9), Historical Access (Part 11)" },
      { text: "Companion spec loading via XML nodeset (Euromap, PackML, LADS, umati)" },
    ],
  },
  {
    category: "Production hardening",
    intro: "The plumbing that matters when the deploy is not a demo.",
    items: [
      { text: "OPC UA Role-Based Security and User Management (Part 18)", href: url("role_based_security.html") },
      { text: "Certificate lifecycle: X.509, PKI toolchain, encrypted persistence" },
      { text: "Session and channel auto-recovery, reverse-connect for restricted networks" },
      { text: "Audit events, hot-reloadable identity mapping, no side-channel admin protocol" },
    ],
  },
  {
    category: "TypeScript-first ergonomics",
    intro: "The developer surface Node.js and TypeScript teams already expect.",
    items: [
      { text: "Full TypeScript types across every public API and every companion spec" },
      { text: "Async/await everywhere, no callback layers, no thread pools" },
      { text: "3,000+ tests, ~97% coverage, releases every two weeks on average" },
      { text: "Runs on Node.js 18+ across Windows, Linux, macOS, Alpine. npm install, zero native dependencies" },
    ],
  },
];
---

<section class="capabilities-section">
  <div class="container">
    <div class="section-header">
      <span class="section-eyebrow">Capabilities</span>
      <h2 class="section-title">What node-opcua actually implements.</h2>
      <p class="section-subtitle">
        Three claims about the stack. Everything below is in the MIT-licensed core.
      </p>
    </div>

    <div class="capabilities-grid">
      {features.map((group) => (
        <div class="capability-group">
          <h3 class="group-title">{group.category}</h3>
          <p class="group-intro">{group.intro}</p>
          <ul class="feature-list">
            {group.items.map((item) => (
              <li class="feature-item">
                <span class="check">✓</span>
                {item.href
                  ? <a href={item.href} class="feature-link">{item.text}</a>
                  : <span>{item.text}</span>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .capabilities-section {
    padding: var(--space-section) 0;
    background-color: var(--bg-elevated);
  }
  .section-header {
    text-align: center;
    max-width: 650px;
    margin: 0 auto 3.5rem auto;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .section-title {
    font-size: clamp(1.8rem, 4vw, 2.25rem);
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.025em;
  }
  .section-subtitle {
    font-size: 1rem;
    color: var(--ink-soft);
    line-height: 1.6;
  }
  .capabilities-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    max-width: 1000px;
    margin: 0 auto;
  }
  .capability-group {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .group-title {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    font-weight: 600;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--divider);
  }
  .group-intro {
    font-size: 0.9rem;
    color: var(--ink-soft);
    line-height: 1.5;
    margin: 0 0 0.5rem 0;
  }
  .feature-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .feature-item {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    font-size: 0.9375rem;
    color: var(--ink);
    line-height: 1.5;
  }
  .check {
    color: var(--accent);
    font-weight: 700;
    font-size: 0.85rem;
    flex-shrink: 0;
  }
  .feature-link {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--divider);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.15s ease;
  }
  .feature-link:hover,
  .feature-link:focus-visible {
    text-decoration-color: var(--accent);
    color: var(--accent);
  }
  .pro-badge, .pro-badge-inline {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent);
    border: 1.5px solid var(--accent);
    border-radius: 3px;
    padding: 1px 5px;
    margin-left: 0.35rem;
    vertical-align: middle;
    white-space: nowrap;
  }
  .pro-badge-inline {
    font-size: 0.55rem;
  }
  .capabilities-footnote {
    max-width: 1000px;
    margin: 2.5rem auto 0 auto;
    font-size: 0.85rem;
    color: var(--muted);
    line-height: 1.5;
    text-align: center;
  }
  .capabilities-footnote a {
    color: var(--accent);
    text-decoration: underline;
  }
  .capabilities-footnote a:hover {
    color: var(--ink);
  }

  @media (min-width: 768px) {
    .capabilities-grid {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 3rem;
    }
  }
</style>
