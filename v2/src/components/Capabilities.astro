---
const features = [
  {
    category: "Core protocol (MIT)",
    items: [
      { text: "Full OPC UA client & server SDK", pro: false },
      { text: "Subscriptions & monitored items", pro: false },
      { text: "Method calls (synchronous & async)", pro: false },
      { text: "Browse, read, write, call, history read", pro: false },
      { text: "Complex types & custom structures", pro: false },
      { text: "Alarms & conditions (A&C)", pro: false },
      { text: "Historical access (HA)", pro: false },
      { text: "File transfer (Part 20)", pro: false },
    ],
  },
  {
    category: "Security & certificates (MIT)",
    items: [
      { text: "Secure channels (Sign, SignAndEncrypt)", pro: false },
      { text: "node-opcua-pki — certificate authority & PKI toolchain", pro: false },
      { text: "node-opcua-crypto — OPC UA crypto primitives", pro: false },
      { text: "Certificate management (X.509)", pro: false },
      { text: "Role-based security (Part 18)", pro: false },
      { text: "User identity tokens (anonymous, user/pass, X.509)", pro: false },
    ],
  },
  {
    category: "Developer experience",
    items: [
      { text: "Full TypeScript types & generics", pro: false },
      { text: "Async/await throughout", pro: false },
      { text: "3,000+ tests · ~97% coverage", pro: false },
      { text: "Node.js 16 – 22 supported", pro: false },
      { text: "Windows · Linux · macOS · Alpine", pro: false },
      { text: "npm install — zero native deps", pro: false },
    ],
  },
  {
    category: "Integration & ecosystem",
    items: [
      { text: "Companion spec support (Euromap, PackML, LADS)", pro: false },
      { text: "Node-RED OPC UA nodes", pro: false },
      { text: "XML nodeset import/export", pro: false },
      { text: "Reverse connect", pro: false },
      { text: "Session & channel recovery", pro: false },
    ],
  },
  {
    category: "Commercial add-ons",
    items: [
      { text: "Global Discovery Server (GDS)", pro: true },
      { text: "PubSub (UADP + JSON over MQTT)", pro: true },
      { text: "Optimized OPC UA client — high-throughput reads", pro: true },
      { text: "Address space crawler & exporter", pro: true },
      { text: "React UI components for OPC UA", pro: true },
      { text: "WebProxy — browser-to-OPC UA bridge", pro: true },
    ],
  },
];
---

<section class="capabilities-section">
  <div class="container">
    <div class="section-header">
      <span class="section-eyebrow">Capabilities</span>
      <h2 class="section-title">What's in the stack.</h2>
      <p class="section-subtitle">
        node-opcua implements the OPC UA specification broadly and deeply.
        Here's what ships in the current release.
      </p>
    </div>

    <div class="capabilities-grid">
      {features.map((group) => (
        <div class="capability-group">
          <h3 class="group-title">{group.category}</h3>
          <ul class="feature-list">
            {group.items.map((item) => (
              <li class="feature-item">
                <span class="check">✓</span>
                <span>{item.text}</span>
                {item.pro && <span class="pro-badge">PRO</span>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class="capabilities-footnote">
      Items marked <span class="pro-badge-inline">PRO</span> are commercial add-on modules,
      available with a <a href="https://www.sterfive.com" target="_blank" rel="noopener noreferrer">Sterfive subscription</a>.
      Source code is available. The core SDK and unmarked items above are MIT-licensed.
      Some ecosystem packages (e.g. node-i3x) use AGPL + commercial dual licensing.
    </p>
  </div>
</section>

<style>
  .capabilities-section {
    padding: var(--space-section) 0;
    background-color: var(--bg-elevated);
  }
  .section-header {
    text-align: center;
    max-width: 650px;
    margin: 0 auto 3.5rem auto;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .section-title {
    font-size: clamp(1.8rem, 4vw, 2.25rem);
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.025em;
  }
  .section-subtitle {
    font-size: 1rem;
    color: var(--ink-soft);
    line-height: 1.6;
  }
  .capabilities-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    max-width: 1000px;
    margin: 0 auto;
  }
  .capability-group {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .group-title {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    font-weight: 600;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--divider);
  }
  .feature-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .feature-item {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    font-size: 0.9375rem;
    color: var(--ink);
    line-height: 1.5;
  }
  .check {
    color: var(--accent);
    font-weight: 700;
    font-size: 0.85rem;
    flex-shrink: 0;
  }
  .pro-badge, .pro-badge-inline {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent);
    border: 1.5px solid var(--accent);
    border-radius: 3px;
    padding: 1px 5px;
    margin-left: 0.35rem;
    vertical-align: middle;
    white-space: nowrap;
  }
  .pro-badge-inline {
    font-size: 0.55rem;
  }
  .capabilities-footnote {
    max-width: 1000px;
    margin: 2.5rem auto 0 auto;
    font-size: 0.85rem;
    color: var(--muted);
    line-height: 1.5;
    text-align: center;
  }
  .capabilities-footnote a {
    color: var(--accent);
    text-decoration: underline;
  }
  .capabilities-footnote a:hover {
    color: var(--ink);
  }

  @media (min-width: 768px) {
    .capabilities-grid {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 3rem;
    }
  }
</style>
