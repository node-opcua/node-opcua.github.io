<section class="trust-signals-section">
  <div class="container">
    <div class="trust-grid">
      <div class="trust-column">
        <ul class="trust-list">
          <li class="trust-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="check-icon"><path d="M20 6 9 17l-5-5"/></svg>
            <span>12 years of continuous development</span>
          </li>
          <li class="trust-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="check-icon"><path d="M20 6 9 17l-5-5"/></svg>
            <span>3,000+ tests &middot; ~97% coverage</span>
          </li>
          <li class="trust-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="check-icon"><path d="M20 6 9 17l-5-5"/></svg>
            <span>Windows &middot; Linux &middot; macOS &middot; Alpine &middot; browser</span>
          </li>
        </ul>
      </div>
      
      <div class="trust-column">
        <ul class="trust-list">
          <li class="trust-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="check-icon"><path d="M20 6 9 17l-5-5"/></svg>
            <span>OPC Foundation Corporate Member</span>
          </li>
          <li class="trust-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="check-icon"><path d="M20 6 9 17l-5-5"/></svg>
            <span>MIT licensed</span>
          </li>
          <li class="trust-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="check-icon"><path d="M20 6 9 17l-5-5"/></svg>
            <span>Maintained by Sterfive SAS, France</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .trust-signals-section {
    padding: 4rem 0;
    background-color: rgba(11, 15, 25, 0.4);
    border-top: 1px solid var(--border-color);
  }
  .trust-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    max-width: 900px;
    margin: 0 auto;
  }
  .trust-column {
    display: flex;
    flex-direction: column;
  }
  .trust-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .trust-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--text-color);
  }
  .check-icon {
    color: var(--accent-color);
    flex-shrink: 0;
  }
  
  @media (max-width: 768px) {
    .trust-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding: 0 1rem;
    }
  }
</style>
