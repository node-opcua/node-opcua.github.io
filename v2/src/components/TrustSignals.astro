---
---
<section class="trust-signals-section">
  <div class="container">
    <div class="section-header">
      <p class="section-eyebrow">What you're getting</p>
      <h2 class="section-heading">Built to industrial standards.</h2>
    </div>
    <div class="trust-grid">
      <div class="trust-column">
        <h4 class="trust-column-title">Engineering</h4>
        <ul class="trust-list">
          <li class="trust-item">
            <span class="bullet-dot"></span>
            <span>12 years of continuous development</span>
          </li>
          <li class="trust-item">
            <span class="bullet-dot"></span>
            <span>3,000+ tests &middot; ~97% coverage</span>
          </li>
          <li class="trust-item">
            <span class="bullet-dot"></span>
            <span>Windows &middot; Linux &middot; macOS &middot; Alpine &middot; browser</span>
          </li>
        </ul>
      </div>
      
      <div class="trust-column">
        <h4 class="trust-column-title">Standards &amp; licensing</h4>
        <ul class="trust-list">
          <li class="trust-item">
            <span class="bullet-dot"></span>
            <span>OPC Foundation Corporate Member</span>
          </li>
          <li class="trust-item">
            <span class="bullet-dot"></span>
            <span>MIT licensed</span>
          </li>
          <li class="trust-item">
            <span class="bullet-dot"></span>
            <span>Maintained by Sterfive SAS, France</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .trust-signals-section {
    padding: var(--space-section) 0;
    background-color: var(--bg);
    border-top: 1px solid var(--divider);
  }
  .section-header {
    margin-bottom: var(--space-stack-xl);
  }
  .section-heading {
    font-size: clamp(1.8rem, 4vw, 2.25rem);
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.025em;
  }
  .trust-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-stack-xl);
    max-width: 900px;
    margin: 0 auto;
  }
  .trust-column {
    display: flex;
    flex-direction: column;
  }
  .trust-column-title {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin-bottom: 1rem;
    font-weight: 600;
  }
  .trust-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .trust-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--ink);
  }
  .bullet-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--accent);
    flex-shrink: 0;
  }
  
  @media (min-width: 768px) {
    .trust-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
