---
import { fetchLatestVersion } from '../../scripts/fetch-npm-version.mjs';
const latestVersion = await fetchLatestVersion('node-opcua');
---
<header class="navbar">
  <div class="container navbar-container">
    <a href="/v2/" class="logo">
      <span class="logo-dot"></span><span class="logo-text">node-opcua</span>
    </a>

    <button
      class="menu-trigger"
      aria-label="Open menu"
      aria-expanded="false"
      type="button"
    >
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
    </button>

    <div class="backdrop" aria-hidden="true"></div>

    <nav class="nav-drawer" aria-label="Main navigation">
      <a href="/api_doc/latest/" class="nav-link">API reference</a>
      <a href="/v2/projects/" class="nav-link">Projects</a>
      <a href="/v2/news/" class="nav-link">News</a>
      {latestVersion && (
        <a
          href={`https://www.npmjs.com/package/node-opcua/v/${latestVersion}`}
          target="_blank"
          rel="noopener noreferrer"
          class="version-badge"
          aria-label={`Latest release: v${latestVersion}`}
        >
          <span class="version-number">v{latestVersion}</span>
          <span class="version-label">latest</span>
        </a>
      )}
      <a href="https://github.com/node-opcua/node-opcua" target="_blank" rel="noopener noreferrer" class="nav-link">GitHub</a>
      <a href="https://github.com/sponsors/node-opcua" target="_blank" rel="noopener noreferrer" class="nav-link">Sponsor</a>
    </nav>
  </div>
</header>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(var(--bg-rgb), 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--divider);
  }

  .navbar-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--ink);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.15rem;
    z-index: 120;
  }

  .logo-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    background: var(--accent);
  }

  .logo-text {
    letter-spacing: -0.02em;
  }

  /* ── Hamburger trigger ── */

  .menu-trigger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    z-index: 120;
  }

  .hamburger-bar {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--ink);
    border-radius: 1px;
  }

  @media (min-width: 768px) {
    .menu-trigger {
      display: none;
    }
  }

  /* ── Backdrop ── */

  .backdrop {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 105;
    background: rgba(0, 0, 0, 0.4);
  }

  .backdrop.is-open {
    display: block;
  }

  @media (min-width: 768px) {
    .backdrop {
      display: none !important;
    }
  }

  /* ── Nav drawer / links ── */

  .nav-drawer {
    position: fixed;
    top: 0;
    right: 0;
    z-index: 110;
    display: flex;
    flex-direction: column;
    width: min(85vw, 320px);
    height: 100dvh;
    padding: 4.5rem 1.5rem 2rem;
    background: var(--bg);
    border-left: 1px solid var(--divider);
    transform: translateX(100%);
    transition: transform 0.2s ease;
    overflow-y: auto;
  }

  .nav-drawer.is-open {
    transform: translateX(0);
  }

  .nav-link {
    display: block;
    padding: 0.75rem 0;
    color: var(--ink-soft);
    text-decoration: none;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    letter-spacing: 0.01em;
    border-bottom: 1px solid var(--divider);
    transition: color 0.15s ease;
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    color: var(--ink);
  }

  @media (min-width: 768px) {
    .nav-drawer {
      position: static;
      flex-direction: row;
      width: auto;
      height: auto;
      padding: 0;
      background: none;
      border-left: none;
      transform: none;
      transition: none;
      overflow: visible;
      gap: var(--space-stack-md, 1.5rem);
    }

    .nav-link {
      display: inline;
      padding: 0;
      border-bottom: none;
      font-size: 0.9rem;
    }

    .version-badge {
      display: inline-flex;
    }
  }

  /* Version badge */
  .version-badge {
    display: none;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0.625rem;
    border: 1px solid var(--divider);
    border-radius: 4px;
    text-decoration: none;
    transition: border-color 0.15s ease;
  }
  .version-badge:hover {
    border-color: var(--accent);
  }
  .version-number {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent);
    font-weight: 500;
  }
  .version-label {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    color: var(--muted);
    text-transform: lowercase;
    letter-spacing: 0.02em;
  }
</style>

<script>
  const trigger = document.querySelector<HTMLButtonElement>('.menu-trigger');
  const drawer = document.querySelector<HTMLElement>('.nav-drawer');
  const backdrop = document.querySelector<HTMLElement>('.backdrop');

  if (trigger && drawer && backdrop) {
    const links = drawer.querySelectorAll<HTMLAnchorElement>('.nav-link');

    function openMenu() {
      drawer.classList.add('is-open');
      backdrop.classList.add('is-open');
      trigger.setAttribute('aria-label', 'Close menu');
      trigger.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';

      // Focus first link
      if (links.length > 0) {
        links[0].focus();
      }
    }

    function closeMenu() {
      drawer.classList.remove('is-open');
      backdrop.classList.remove('is-open');
      trigger.setAttribute('aria-label', 'Open menu');
      trigger.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      trigger.focus();
    }

    function isOpen(): boolean {
      return drawer.classList.contains('is-open');
    }

    // Toggle on trigger click
    trigger.addEventListener('click', () => {
      if (isOpen()) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    // Close on backdrop click
    backdrop.addEventListener('click', () => {
      closeMenu();
    });

    // Close when a nav link is clicked
    links.forEach((link) => {
      link.addEventListener('click', () => {
        closeMenu();
      });
    });

    // Escape key closes drawer
    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape' && isOpen()) {
        closeMenu();
      }
    });

    // Basic focus trap inside the drawer when open
    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key !== 'Tab' || !isOpen()) return;

      const focusable = [
        trigger,
        ...Array.from(links),
      ] as HTMLElement[];

      const first = focusable[0];
      const last = focusable[focusable.length - 1];

      if (e.shiftKey) {
        if (document.activeElement === first) {
          e.preventDefault();
          last.focus();
        }
      } else {
        if (document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });
  }
</script>
