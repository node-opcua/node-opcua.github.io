---
---
<header class="navbar">
  <div class="container navbar-container">
    <a href="/v2/" class="logo">
      <span class="logo-text">node-opcua</span>
    </a>
    <nav class="nav-links">
      <a href="/api_doc/latest/" class="nav-link">API reference</a>
      <a href="/news/" class="nav-link">News</a>
      <a href="https://github.com/node-opcua/node-opcua" target="_blank" rel="noopener noreferrer" class="nav-link">GitHub</a>
      <a href="https://github.com/sponsors/node-opcua" target="_blank" rel="noopener noreferrer" class="nav-link sponsor-btn">Sponsor</a>
    </nav>
  </div>
</header>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: rgba(11, 15, 25, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-color);
  }
  .navbar-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 4.5rem;
  }
  .logo {
    display: flex;
    align-items: center;
    font-weight: 700;
    font-size: 1.25rem;
    color: #fff;
    letter-spacing: -0.025em;
  }
  .logo-text {
    background: linear-gradient(135deg, #fff 60%, var(--accent-color));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .nav-link {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-muted);
  }
  .nav-link:hover {
    color: #fff;
  }
  .sponsor-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.4rem 0.9rem;
    border-radius: 4px;
    border: 1px solid var(--accent-color);
    color: var(--accent-color) !important;
    transition: all 0.2s ease;
  }
  .sponsor-btn:hover {
    background-color: var(--accent-muted);
    color: var(--accent-hover) !important;
  }
  
  @media (max-width: 768px) {
    .nav-links {
      gap: 1.25rem;
    }
  }
</style>
