---
---
<section class="ecosystem-section">
  <div class="container ecosystem-container">
    <a class="ecosystem-item" href="https://nodejs.org" target="_blank" rel="noopener noreferrer">
      <span class="eyebrow">Built on</span>
      <span class="project-name">Node.js</span>
    </a>

    <a class="ecosystem-item" href="https://www.typescriptlang.org" target="_blank" rel="noopener noreferrer">
      <span class="eyebrow">Written in</span>
      <span class="project-name">TypeScript</span>
    </a>

    <a class="ecosystem-item" href="https://opcfoundation.org" target="_blank" rel="noopener noreferrer">
      <span class="eyebrow">Implements</span>
      <span class="project-name">OPC UA</span>
    </a>

    <a class="ecosystem-item" href="https://www.sterfive.com" target="_blank" rel="noopener noreferrer">
      <span class="eyebrow">Maintained by</span>
      <span class="project-name">Sterfive</span>
    </a>
  </div>
</section>

<style>
  .ecosystem-section {
    padding: 2rem 0;
    background-color: var(--bg);
    border-top: 1px solid var(--divider);
    border-bottom: 1px solid var(--divider);
  }
  .ecosystem-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  .ecosystem-item {
    display: block;
    text-decoration: none;
  }
  .ecosystem-item:hover .project-name {
    color: var(--accent);
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
    font-weight: 500;
    display: block;
    margin-bottom: 0.25rem;
  }
  .project-name {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 500;
    color: var(--ink);
    display: block;
    transition: color 0.2s ease;
  }
  
  @media (min-width: 768px) {
    .ecosystem-container {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.75rem;
    }
  }
  @media (min-width: 1024px) {
    .ecosystem-container {
      grid-template-columns: repeat(4, 1fr);
      gap: 2.5rem;
    }
    .ecosystem-section {
      padding: 3rem 0;
    }
    /* Vertical dividers between items on desktop */
    .ecosystem-item {
      position: relative;
    }
    .ecosystem-item:not(:last-child)::after {
      content: "";
      position: absolute;
      right: -1.25rem;
      top: 50%;
      transform: translateY(-50%);
      width: 1px;
      height: 1.5rem;
      background: var(--divider);
    }
  }
</style>
