---
---
<section class="ecosystem-section">
  <div class="container ecosystem-container">
    <!-- Column 1: Node.js -->
    <a href="https://nodejs.org" target="_blank" rel="noopener noreferrer" class="ecosystem-item">
      <span class="eyebrow">Built on</span>
      <div class="logo-wrapper">
        <img src="/v2/logos/nodejs-logo.png" alt="" class="eco-icon nodejs-logo-img" />
        <span class="logo-text">Node.js</span>
      </div>
    </a>

    <!-- Column 2: TypeScript -->
    <a href="https://www.typescriptlang.org" target="_blank" rel="noopener noreferrer" class="ecosystem-item">
      <span class="eyebrow">Written in</span>
      <div class="logo-wrapper">
        <svg viewBox="0 0 24 24" class="eco-icon ts-icon" fill="currentColor" aria-hidden="true" focusable="false"><rect width="24" height="24" rx="2"/><text x="18" y="19" font-family="var(--font-sans)" font-weight="800" font-size="14" fill="#ffffff" text-anchor="end">TS</text></svg>
        <span class="logo-text">TypeScript</span>
      </div>
    </a>

    <!-- Column 3: OPC Foundation -->
    <a href="https://opcfoundation.org" target="_blank" rel="noopener noreferrer" class="ecosystem-item">
      <span class="eyebrow">Implements</span>
      <div class="logo-wrapper">
        <img src="/v2/logos/opcua-logo.png" alt="" class="eco-icon opcua-logo-img" />
        <span class="logo-text">OPC Foundation</span>
      </div>
    </a>

    <!-- Column 4: Sterfive -->
    <a href="https://www.sterfive.com" target="_blank" rel="noopener noreferrer" class="ecosystem-item">
      <span class="eyebrow">Maintained by</span>
      <div class="logo-wrapper">
        <img src="/v2/logos/sterfive-logo.png" alt="" class="eco-icon sterfive-logo-img" />
        <span class="logo-text">Sterfive</span>
      </div>
    </a>
  </div>
</section>

<style>
  .ecosystem-section {
    padding: 2rem 0;
    background-color: var(--bg);
    border-bottom: 1px solid var(--divider);
  }
  .ecosystem-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  .ecosystem-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: var(--ink-soft);
    text-decoration: none;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), color 0.2s ease;
  }
  .ecosystem-item:hover {
    color: var(--accent);
    transform: translateY(-2px);
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .logo-wrapper {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: 1.75rem;
  }
  .eco-icon {
    width: 1.5rem;
    height: 1.5rem;
    flex-shrink: 0;
    opacity: 0.55;
    fill: currentColor;
    filter: grayscale(100%);
    object-fit: contain;
    transition: opacity 0.2s ease, fill 0.2s ease, transform 0.2s ease, filter 0.2s ease;
  }
  .ecosystem-item:hover .eco-icon {
    opacity: 1;
    transform: scale(1.05);
    filter: grayscale(0%);
  }
  
  /* Brand-color pop on hover */
  .ecosystem-item:hover .nodejs-icon {
    fill: #339933; /* Node.js green */
  }
  .ecosystem-item:hover .ts-icon {
    fill: #3178c6; /* TypeScript blue */
  }
  .ecosystem-item:hover .opc-icon {
    fill: #f39200; /* OPC Foundation orange */
  }
  .ecosystem-item:hover .sterfive-icon {
    fill: var(--accent); /* Sterfive teal */
  }

  .logo-text {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 600;
  }
  
  @media (min-width: 576px) {
    .ecosystem-container {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.75rem;
    }
  }
  @media (min-width: 992px) {
    .ecosystem-container {
      grid-template-columns: repeat(4, 1fr);
      gap: 2.5rem;
    }
    .ecosystem-section {
      padding: 3rem 0;
    }
  }
</style>
