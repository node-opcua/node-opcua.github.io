---
import { customers } from '../data/customers';
---
<section class="social-proof-section">
  <div class="container">
    <div class="social-proof-grid">
      {customers.map((c) => {
        if (c.display === "logo") {
          return (
            <div class="customer-slot logo-slot" id={`customer-${c.id}`}>
              <img src={c.logo} alt={c.name} class="grayscale-logo customer-img" />
            </div>
          );
        } else if (c.display === "name") {
          return (
            <div class="customer-slot text-slot" id={`customer-${c.id}`}>
              <span class="customer-text">{c.fallbackText}</span>
            </div>
          );
        } else {
          return (
            <div class="customer-slot generic-slot" id={`customer-${c.id}`}>
              <span class="customer-generic">{c.genericText}</span>
            </div>
          );
        }
      })}
    </div>
    
    <div class="stats-row">
      <span class="stat-item">3.5M+ npm downloads</span>
      <span class="divider">&middot;</span>
      <span class="stat-item">1,600+ GitHub stars</span>
      <span class="divider">&middot;</span>
      <span class="stat-item">12 years of continuous development</span>
    </div>
  </div>
</section>

<style>
  .social-proof-section {
    padding: 4.5rem 0;
    background-color: var(--bg);
    border-top: 1px solid var(--divider);
    border-bottom: 1px solid var(--divider);
  }
  .social-proof-grid {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 3.5rem;
    margin-bottom: 2.25rem;
  }
  .customer-slot {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 3rem;
    text-align: center;
  }
  .customer-img {
    max-height: 2rem;
    max-width: 120px;
    object-fit: contain;
    filter: grayscale(100%);
    -webkit-filter: grayscale(100%);
    opacity: 0.75;
    transition: opacity 0.2s ease, filter 0.2s ease;
  }
  .customer-img:hover {
    filter: grayscale(0%);
    -webkit-filter: grayscale(0%);
    opacity: 0.95;
  }
  .customer-text {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--ink-soft);
  }
  .customer-generic {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
    max-width: 180px;
    line-height: 1.4;
  }
  .stats-row {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 500;
  }
  .divider {
    color: var(--accent);
    font-weight: bold;
    font-size: 1.15rem;
  }
  
  @media (max-width: 768px) {
    .social-proof-grid {
      gap: 2.25rem;
    }
    .stats-row {
      flex-direction: column;
      gap: 0.5rem;
    }
    .divider {
      display: none;
    }
  }
</style>
