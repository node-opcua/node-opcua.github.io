---
import { customers } from '../data/customers';

const primaryCustomers = customers.filter(c => c.tier === 'primary');
const secondaryCustomers = customers.filter(c => c.tier === 'secondary');
---
<section class="social-proof-section">
  <div class="container proof-container">
    <!-- Primary Tier -->
    <div class="proof-row">
      <h4 class="row-eyebrow">IN PRODUCTION AT</h4>
      <div class="social-proof-grid primary-grid">
        {primaryCustomers.map((c) => {
          if (c.display === "logo") {
            return (
              <div class="customer-slot logo-slot" id={`customer-${c.id}`}>
                <img src={c.logo} alt={c.name} class="grayscale-logo customer-img primary-img" />
              </div>
            );
          } else if (c.display === "name") {
            return (
              <div class="customer-slot text-slot" id={`customer-${c.id}`}>
                <span class="customer-text">{c.fallbackText}</span>
              </div>
            );
          } else {
            return (
              <div class="customer-slot generic-slot" id={`customer-${c.id}`}>
                <span class="customer-generic">{c.genericText}</span>
              </div>
            );
          }
        })}
      </div>
    </div>

    <!-- Secondary Tier -->
    <div class="proof-row">
      <h4 class="row-eyebrow">ALSO USED BY</h4>
      <div class="social-proof-grid secondary-grid">
        {secondaryCustomers.map((c) => {
          if (c.display === "logo") {
            return (
              <div class="customer-slot logo-slot secondary-slot" id={`customer-${c.id}`}>
                <img src={c.logo} alt={c.name} class="grayscale-logo customer-img secondary-img" />
              </div>
            );
          } else if (c.display === "name") {
            return (
              <div class="customer-slot text-slot secondary-slot" id={`customer-${c.id}`}>
                <span class="customer-text secondary-text">{c.fallbackText}</span>
              </div>
            );
          } else {
            return (
              <div class="customer-slot generic-slot secondary-slot" id={`customer-${c.id}`}>
                <span class="customer-generic secondary-generic">{c.genericText}</span>
              </div>
            );
          }
        })}
      </div>
    </div>
    
    <div class="stats-row">
      <span class="stat-item">3.5M+ npm downloads</span>
      <span class="divider">&middot;</span>
      <span class="stat-item">1,600+ GitHub stars</span>
      <span class="divider">&middot;</span>
      <span class="stat-item">12 years of continuous development</span>
    </div>
  </div>
</section>

<style>
  .social-proof-section {
    padding: 5rem 0;
    background-color: var(--bg);
    border-top: 1px solid var(--divider);
    border-bottom: 1px solid var(--divider);
  }
  .proof-container {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }
  .proof-row {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }
  .row-eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin: 0;
    text-align: center;
  }
  .social-proof-grid {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 3.5rem;
  }
  .secondary-grid {
    gap: 2.5rem;
  }
  .customer-slot {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 3rem;
    text-align: center;
  }
  .secondary-slot {
    height: 2.25rem;
  }
  .customer-img {
    max-height: 2rem;
    max-width: 120px;
    object-fit: contain;
    filter: grayscale(100%);
    -webkit-filter: grayscale(100%);
    opacity: 0.75;
    transition: opacity 0.2s ease, filter 0.2s ease;
  }
  .customer-img:hover {
    filter: grayscale(0%);
    -webkit-filter: grayscale(0%);
    opacity: 0.95;
  }
  .secondary-img {
    max-height: 1.4rem; /* ~70% of 2rem */
    max-width: 84px;    /* ~70% of 120px */
    opacity: 0.55;
  }
  .secondary-img:hover {
    filter: grayscale(0%);
    -webkit-filter: grayscale(0%);
    opacity: 0.85;
  }
  .customer-text {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--ink-soft);
  }
  .secondary-text {
    font-size: 0.75rem;
    opacity: 0.7;
  }
  .customer-generic {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
    max-width: 180px;
    line-height: 1.4;
  }
  .secondary-generic {
    font-size: 0.65rem;
    max-width: 140px;
  }
  .stats-row {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 500;
    padding-top: 1.5rem;
    border-top: 1px solid var(--divider);
  }
  .divider {
    color: var(--accent);
    font-weight: bold;
    font-size: 1.15rem;
  }
  
  @media (max-width: 768px) {
    .social-proof-grid {
      gap: 2.25rem;
    }
    .secondary-grid {
      gap: 1.75rem;
    }
    .stats-row {
      flex-direction: column;
      gap: 0.5rem;
    }
    .divider {
      display: none;
    }
  }
</style>
