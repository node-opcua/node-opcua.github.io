<footer class="footer">
  <div class="container footer-container">
    <div class="footer-left">
      <p class="copyright">node-opcua — maintained by Sterfive SAS &middot; MIT licensed</p>
    </div>
    <div class="footer-center">
      <a href="/api_doc/latest/">Docs</a>
      <a href="/news/">News</a>
      <a href="https://github.com/node-opcua/node-opcua" target="_blank" rel="noopener noreferrer">GitHub</a>
