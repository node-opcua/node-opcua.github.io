---
import { url } from '../utils/url';

const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const isStaging = import.meta.env.PUBLIC_STAGING === "true";
const analyticsEnabled = gaId && !isStaging;
---
<footer class="footer">
  <div class="container footer-container">
    <div class="footer-left">
      <p class="copyright"><strong>node-opcua</strong> &middot; maintained by Sterfive SAS &middot; MIT licensed</p>
    </div>
    <div class="footer-center">
      <a href="/api_doc/latest/">Docs</a>
      <a href={url("projects.html")}>Projects</a>
      <a href={url("news.html")}>News</a>
      <a href="https://github.com/node-opcua/node-opcua" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="https://www.npmjs.com/package/node-opcua" target="_blank" rel="noopener noreferrer">npm</a>
      <a href="https://github.com/sponsors/node-opcua" target="_blank" rel="noopener noreferrer">Sponsor</a>
      <a href={url("privacy.html")}>Privacy</a>
      {analyticsEnabled && (
        <button id="reset-analytics-consent"
                type="button"
                class="footer-analytics-btn"
                aria-label="Reset analytics consent preference">
          Analytics: manage
        </button>
      )}
    </div>
    <div class="footer-right">
      <p>For commercial inquiries: <a href="https://www.sterfive.com" target="_blank" rel="noopener noreferrer" class="commercial-link">sterfive.com</a></p>
    </div>
  </div>
</footer>

{analyticsEnabled && (
  <script is:inline>
    (function() {
      var btn = document.getElementById('reset-analytics-consent');
      if (!btn) return;
      btn.addEventListener('click', function() {
        // Clear the consent cookie so the banner reappears on next load.
        document.cookie = 'na_consent=; max-age=0; path=/; SameSite=Lax';
        // Reload so the banner mounts fresh and Consent Mode reverts to default DENIED.
        window.location.reload();
      });
    })();
  </script>
)}

<style>
  .footer {
    background-color: var(--bg-elevated);
    border-top: 1px solid var(--divider);
    padding: var(--space-section-sm) 0;
    margin-top: auto;
  }
  .footer-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .footer-left, .footer-right {
    font-size: 0.875rem;
    color: var(--ink-soft);
  }
  .footer-left p, .footer-right p {
    font-size: 0.875rem;
    color: var(--ink-soft);
  }
  .footer-center {
    display: flex;
    gap: 1.5rem;
  }
  .footer-center a,
  .footer-center .footer-analytics-btn {
    font-size: 0.875rem;
    color: var(--ink-soft);
    transition: color 0.15s ease;
  }
  .footer-center a:hover,
  .footer-center .footer-analytics-btn:hover,
  .footer-center .footer-analytics-btn:focus-visible {
    color: var(--accent);
  }
  .footer-analytics-btn {
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
    font-family: inherit;
  }
  .commercial-link {
    color: var(--accent);
    font-weight: 500;
  }
  .commercial-link:hover {
    color: var(--ink);
    text-decoration: underline;
  }
  @media (max-width: 768px) {
    .footer-container {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 1.5rem;
    }
    .footer-center {
      flex-wrap: wrap;
      justify-content: center;
      gap: 1rem;
    }
  }
</style>
